# =============================================================================
# Textileways environment variables
# =============================================================================
#
# Copy this file to .env.local for local development, and set the same values in
# the Vercel project settings for preview and production.
#
# The site is built to run with none of these set. Anything unconfigured degrades
# in a documented way rather than failing:
#
#   no CMS       -> the typed fallback content in content/fallback is used
#   no email     -> submissions still validate and get a reference, and are
#                   logged server side rather than silently lost
#   no storage   -> attachments are declined with an explanation, and the
#                   inquiry can still be submitted
#   no Turnstile -> the honeypot, timing check, rate limit and Zod validation
#                   still apply
#   no analytics -> the consent banner never appears and tracking is inert
#
# Which of these are required before launch is listed in docs/LAUNCH_CHECKLIST.md.
# =============================================================================


# -----------------------------------------------------------------------------
# Site. Required.
# -----------------------------------------------------------------------------

# Canonical origin, with no trailing slash. Used for canonical tags, the sitemap,
# absolute Open Graph image URLs and structured data.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL="https://www.textileways.com"


# -----------------------------------------------------------------------------
# Sanity CMS. Optional until content is managed in a Studio.
# -----------------------------------------------------------------------------

# From the Sanity project settings. Both of these must be set together, or the
# site uses its built in fallback content.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# Optional. Only needed to read drafts or a private dataset. Server side only:
# never prefix this with NEXT_PUBLIC.
SANITY_API_READ_TOKEN=""

# Optional. Pins the API version. Defaults to 2024-10-01 when unset.
SANITY_API_VERSION="2024-10-01"

# Shared secret for POST /api/revalidate. Required before a CMS webhook can
# invalidate cached pages. Generate with: openssl rand -hex 32
# Without it the endpoint returns 503 rather than revalidating, so an
# unprotected deployment cannot be used to force cache invalidation.
SANITY_REVALIDATE_SECRET=""


# -----------------------------------------------------------------------------
# Transactional email. Required before launch.
# -----------------------------------------------------------------------------

# Resend API key. https://resend.com/api-keys
RESEND_API_KEY=""

# The From address. Its domain must be verified in Resend, and that domain
# verification uses TXT and CNAME records only. It does not require any change
# to MX records, so existing cPanel email keeps working. See docs/DEPLOYMENT.md.
RFQ_FROM_EMAIL="Textileways <inquiries@textileways.com>"

# Internal recipients for new inquiries. Comma separated for more than one.
RFQ_TO_EMAIL="sales@textileways.com"


# -----------------------------------------------------------------------------
# Spam protection. Strongly recommended before launch.
# -----------------------------------------------------------------------------

# Cloudflare Turnstile. https://dash.cloudflare.com -> Turnstile
# When the secret is absent, verification is skipped and the fact is logged.
# When it is present, a valid token becomes mandatory on every form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""


# -----------------------------------------------------------------------------
# Attachment storage. Required for RFQ file uploads.
# -----------------------------------------------------------------------------

# Vercel Blob read write token. Created with the Blob store in the Vercel
# dashboard. Without it, uploads are declined with an explanation and the
# inquiry can still be submitted without files.
BLOB_READ_WRITE_TOKEN=""


# -----------------------------------------------------------------------------
# Analytics. Optional.
# -----------------------------------------------------------------------------

# Google Analytics measurement id, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=""

# Microsoft Clarity project id.
NEXT_PUBLIC_CLARITY_ID=""

# Neither loads until a visitor accepts analytics cookies. When both are empty,
# the consent banner never appears, because there is nothing to consent to.


# -----------------------------------------------------------------------------
# CRM. Optional, not yet wired up.
# -----------------------------------------------------------------------------

# Reserved for a future HubSpot integration. Nothing reads this today; adding it
# has no effect until the integration is built.
HUBSPOT_ACCESS_TOKEN=""
